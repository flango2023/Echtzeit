# Local editor workspace (belongs to the Pulso projects, not to Echtzeit)
Pulso.code-workspace

# macOS
.DS_Store

# Python. `.venv` may be a symlink to `.venv.nosync` (see the README), so both are listed
# without a trailing slash, which would not match a symlink.
.venv
.venv.nosync
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Local databases and generated output
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
/out/

# Kiro local configuration
.kiro/

# Secrets
.env

# API key files (hashes of secrets; never commit)
keys*.json
# Database encryption keys (never commit)
*.key
